# zorn uses the qcom_us fingerprint implementation.  It communicates with
# QBT and the Xiaomi FOD kernel device in addition to the common Goodix node.
allow hal_fingerprint_default vendor_qbt_device:chr_file rw_file_perms;

# The Goodix under-display implementation reads the battery temperature while
# it drives calibration and enrollment.
allow hal_fingerprint_default vendor_sysfs_battery_supply:dir search;
allow hal_fingerprint_default vendor_sysfs_battery_supply:file r_file_perms;
