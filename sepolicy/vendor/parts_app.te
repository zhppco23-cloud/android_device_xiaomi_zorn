# These service types are vendor-private, so cross-partition binder access
# belongs in vendor policy rather than system_ext private policy.
binder_call(parts_app, hal_touchfeature_xiaomi_default)
binder_call(parts_app, vendor_hal_displayfeature_xiaomi_default)
allow parts_app hal_touchfeature_xiaomi_service:service_manager find;
allow parts_app vendor_hal_displayfeature_xiaomi_service:service_manager find;

allow parts_app vendor_sysfs_graphics:dir search;
allow parts_app vendor_sysfs_graphics:file rw_file_perms;
allow parts_app vendor_sysfs_kgsl:dir search;
allow parts_app vendor_sysfs_kgsl:{ file lnk_file } rw_file_perms;
allow parts_app vendor_sysfs_battery_supply:dir search;
allow parts_app vendor_sysfs_battery_supply:file rw_file_perms;
allow parts_app vendor_sysfs_kgsl_gpuclk:file { getattr open read };
